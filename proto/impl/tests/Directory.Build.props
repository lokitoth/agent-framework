<Project>

  <Import Project="..\Directory.Build.props" />

  <!-- Projects that are libraries shared across test projects (e.g. TestSupport)
       set IsTestProjectShared=true before this file is imported via their own
       Directory.Build.props one level deeper. -->
  <PropertyGroup Condition="'$(IsTestProjectShared)' != 'true'">
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>

    <!-- The .NET 10 SDK ships with Microsoft.Testing.Platform as the default
         runner; xunit.v3.mtp-v2 plugs into it. -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>

    <!-- Test projects do not require XML docs. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!-- Suppress test-time-only diagnostics. -->
    <NoWarn>$(NoWarn);Moq1410;xUnit1051;CA1707;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsTestProjectShared)' != 'true'">
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3.mtp-v2" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Moq" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsTestProjectShared)' != 'true'">
    <Using Include="Xunit" />
  </ItemGroup>

</Project>

